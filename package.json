{
  "name": "contribmatch",
  "version": "1.0.0",
  "private": true,
  "description": "ContribMatch - matches developers with beginner-friendly GitHub issues and coaches them toward a quality first PR, powered by open-weight Gemma.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/validate-packs.mjs && node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "validate:packs": "node tools/validate-packs.mjs",
    "refresh:catalogue": "node tools/refresh-catalogue.mjs",
    "validate": "npm run validate:packs && npm test",
    "contrast": "node tools/contrast.mjs",
    "a11y": "node tools/a11y-audit.mjs",
    "shots": "node tools/screenshots.mjs",
    "check": "npm run test && npm run contrast && npm run a11y",
    "serve": "python3 -m http.server 8080",
    "dev": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "puppeteer": "^23.0.0"
  }
}
